@page "/inventory-summary"

@using Inventory.Client.Models.Inventory
@using Inventory.Client.Services.Inventory

@inject IInventoryServiceClient InventoryService

<div class="d-flex flex-column gap-4">

    <!-- PAGE HEADER -->

    <div>

        <h3 class="mb-1">
            Inventory Summary
        </h3>

        <div class="text-muted">
            Operational inventory visibility and stock health
        </div>

    </div>

    <!-- KPI STRIP -->

    @if (summary != null)
    {
        <RadzenRow Gap="1rem">

            <!-- TOTAL VALUE -->

            <RadzenColumn Size="12"
                          SizeMD="6"
                          SizeLG="3">

                <RadzenCard Variant="Variant.Flat"
                            class="shadow-sm border-0 h-100">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <small class="text-muted text-uppercase fw-semibold">
                                Inventory Value
                            </small>

                            <h3 class="fw-bold mb-0 text-success">
                                @($"R {summary.TotalInventoryValue:N2}")
                            </h3>

                        </div>

                        <RadzenIcon Icon="payments"
                                    class="fs-1 text-success opacity-75" />

                    </div>

                </RadzenCard>

            </RadzenColumn>

            <!-- TOTAL ITEMS -->

            <RadzenColumn Size="12"
                          SizeMD="6"
                          SizeLG="3">

                <RadzenCard Variant="Variant.Flat"
                            class="shadow-sm border-0 h-100">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <small class="text-muted text-uppercase fw-semibold">
                                Total Items
                            </small>

                            <h3 class="fw-bold mb-0">
                                @filteredItems.Count
                            </h3>

                        </div>

                        <RadzenIcon Icon="inventory_2"
                                    class="fs-1 text-primary opacity-75" />

                    </div>

                </RadzenCard>

            </RadzenColumn>

            <!-- LOW STOCK -->

            <RadzenColumn Size="12"
                          SizeMD="6"
                          SizeLG="3">

                <RadzenCard Variant="Variant.Flat"
                            class="shadow-sm border-0 h-100">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <small class="text-muted text-uppercase fw-semibold">
                                Low Stock
                            </small>

                            <h3 class="fw-bold mb-0 text-warning">
                                @filteredItems.Count(i => i.IsLowStock)
                            </h3>

                        </div>

                        <RadzenIcon Icon="warning"
                                    class="fs-1 text-warning opacity-75" />

                    </div>

                </RadzenCard>

            </RadzenColumn>

            <!-- HEALTHY -->

            <RadzenColumn Size="12"
                          SizeMD="6"
                          SizeLG="3">

                <RadzenCard Variant="Variant.Flat"
                            class="shadow-sm border-0 h-100">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <small class="text-muted text-uppercase fw-semibold">
                                Healthy Items
                            </small>

                            <h3 class="fw-bold mb-0 text-success">
                                @filteredItems.Count(i => !i.IsLowStock)
                            </h3>

                        </div>

                        <RadzenIcon Icon="check_circle"
                                    class="fs-1 text-success opacity-75" />

                    </div>

                </RadzenCard>

            </RadzenColumn>

        </RadzenRow>
    }

    <!-- FILTER BAR -->

    <RadzenCard Variant="Variant.Flat"
                class="shadow-sm border-0">

        <RadzenRow AlignItems="AlignItems.Center"
                   Gap="1rem">

            <!-- SEARCH -->

            <RadzenColumn Size="12"
                          SizeMD="6">

                <RadzenTextBox Placeholder="Search inventory by name or SKU..."
                               Style="width:100%;"
                               @bind-Value="search"
                               Change="@(args => ApplyFilters())" />

            </RadzenColumn>

            <!-- FILTER -->

            <RadzenColumn Size="12"
                          SizeMD="3">

                <RadzenDropDown TValue="string"
                                Data="@stockFilterOptions"
                                Placeholder="Filter inventory"
                                Style="width:100%;"
                                @bind-Value="stockFilter"
                                Change="@(args => ApplyFilters())" />

            </RadzenColumn>

            <!-- REFRESH -->

            <RadzenColumn Size="12"
                          SizeMD="3">

                <RadzenButton Text="Refresh"
                              Icon="refresh"
                              ButtonStyle="ButtonStyle.Light"
                              Style="width:100%;"
                              Click="Reload" />

            </RadzenColumn>

        </RadzenRow>

    </RadzenCard>

    <!-- INVENTORY GRID -->

    @if (summary == null)
    {
        <LoadingSpinner Text="Loading inventory summary..." />
    }
    else if (!filteredItems.Any())
    {
        <EmptyState
            Title="No Inventory Found"
            Message="No inventory items available." />
    }
    else
    {
        <RadzenCard Variant="Variant.Flat"
                    class="shadow-sm border-0">

            <RadzenDataGrid Data="@filteredItems"
                            TItem="InventoryItemDto"
                            AllowPaging="true"
                            PageSize="10"
                            AllowSorting="true"
                            AllowFiltering="false"
                            Responsive="true"
                            EmptyText="No inventory items found">

                <Columns>

                    <!-- SKU -->

                    <RadzenDataGridColumn TItem="InventoryItemDto"
                                          Property="SKU"
                                          Title="SKU" />

                    <!-- ITEM -->

                    <RadzenDataGridColumn TItem="InventoryItemDto"
                                          Property="Name"
                                          Title="Item">

                        <Template Context="item">

                            <div class="d-flex flex-column">

                                <span class="fw-semibold">
                                    @item.Name
                                </span>

                                <small class="text-muted">
                                    Threshold: @item.LowStockThreshold
                                </small>

                            </div>

                        </Template>

                    </RadzenDataGridColumn>

                    <!-- ON HAND -->

                    <RadzenDataGridColumn TItem="InventoryItemDto"
                                          Property="OnHand"
                                          Title="Stock">

                        <Template Context="item">

                            @if (item.OnHand <= 0)
                            {
                                <RadzenBadge Text="Out of Stock"
                                             BadgeStyle="BadgeStyle.Danger"
                                             Shade="Shade.Light"
                                             Variant="Variant.Flat" />
                            }
                            else if (item.IsLowStock)
                            {
                                <RadzenBadge Text="@($"{item.OnHand} Low")"
                                             BadgeStyle="BadgeStyle.Warning"
                                             Shade="Shade.Light"
                                             Variant="Variant.Flat" />
                            }
                            else
                            {
                                <RadzenBadge Text="@($"{item.OnHand} Healthy")"
                                             BadgeStyle="BadgeStyle.Success"
                                             Shade="Shade.Light"
                                             Variant="Variant.Flat" />
                            }

                        </Template>

                    </RadzenDataGridColumn>

                    <!-- UNIT COST -->

                    <RadzenDataGridColumn TItem="InventoryItemDto"
                                          Property="UnitCostPrice"
                                          Title="Unit Cost">

                        <Template Context="item">

                            <span class="fw-semibold text-primary">

                                @($"R {item.UnitCostPrice:N2}")

                            </span>

                        </Template>

                    </RadzenDataGridColumn>

                    <!-- INVENTORY VALUE -->

                    <RadzenDataGridColumn TItem="InventoryItemDto"
                                          Property="InventoryCostValue"
                                          Title="Inventory Value">

                        <Template Context="item">

                            <span class="fw-semibold text-success">

                                @($"R {item.InventoryCostValue:N2}")

                            </span>

                        </Template>

                    </RadzenDataGridColumn>

                    <!-- STATUS -->

                    <RadzenDataGridColumn TItem="InventoryItemDto"
                                          Title="Status"
                                          Sortable="false"
                                          Filterable="false">

                        <Template Context="item">

                            @if (item.OnHand <= 0)
                            {
                                <RadzenBadge Text="CRITICAL"
                                             BadgeStyle="BadgeStyle.Danger"
                                             Shade="Shade.Light"
                                             Variant="Variant.Flat" />
                            }
                            else if (item.IsLowStock)
                            {
                                <RadzenBadge Text="LOW STOCK"
                                             BadgeStyle="BadgeStyle.Warning"
                                             Shade="Shade.Light"
                                             Variant="Variant.Flat" />
                            }
                            else
                            {
                                <RadzenBadge Text="HEALTHY"
                                             BadgeStyle="BadgeStyle.Success"
                                             Shade="Shade.Light"
                                             Variant="Variant.Flat" />
                            }

                        </Template>

                    </RadzenDataGridColumn>

                </Columns>

            </RadzenDataGrid>

        </RadzenCard>
    }

</div>

@code {

    private InventorySummaryDto? summary;

    private List<InventoryItemDto> filteredItems = new();

    private string search = string.Empty;

    private string stockFilter = "All";

    private readonly List<string> stockFilterOptions =
    [
        "All",
        "Healthy",
        "Low Stock",
        "Out of Stock"
    ];

    protected override async Task OnInitializedAsync()
    {
        await Reload();
    }

    private async Task Reload()
    {
        summary =
            await InventoryService
                .GetSummaryAsync();

        ApplyFilters();
    }

    private void ApplyFilters()
    {
        if (summary == null)
            return;

        IEnumerable<InventoryItemDto> query =
            summary.Items;

        // SEARCH

        if (!string.IsNullOrWhiteSpace(search))
        {
            var s =
                search.ToLower();

            query =
                query.Where(i =>
                    i.Name.ToLower().Contains(s)
                    || i.SKU.ToLower().Contains(s));
        }

        // STATUS FILTER

        query = stockFilter switch
        {
            "Healthy" =>
                query.Where(i =>
                    !i.IsLowStock && i.OnHand > 0),

            "Low Stock" =>
                query.Where(i =>
                    i.IsLowStock && i.OnHand > 0),

            "Out of Stock" =>
                query.Where(i =>
                    i.OnHand <= 0),

            _ => query
        };

        filteredItems =
            query.ToList();
    }
}