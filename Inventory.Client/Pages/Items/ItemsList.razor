@page "/items"

@using Inventory.Client.Models.Items
@using Inventory.Client.Components.Items
@using Inventory.Client.Models.Suppliers
@using Inventory.Client.Services.Suppliers
@inject ISupplierService SupplierService

@inject IItemService ItemService

<h3 class="mt-3 mb-4">
    Inventory Items
</h3>

<!-- HEADER ACTIONS -->

<div class="d-flex justify-content-between align-items-center mb-4">

    <!-- SEARCH -->

    <div class="input-group w-50">

        <span class="input-group-text bg-white border-end-0">

            <i class="bi bi-search"></i>

        </span>

        <input class="form-control border-start-0"
               placeholder="Search inventory..."
               @oninput="SearchChanged" />

    </div>

    <!-- SUPPLIER FILTER -->
    <div class="d-flex align-items-center gap-2">

        <span class="text-muted">
            Filter by Supplier:
        </span>

        <select class="form-select form-select-sm"
                style="width: 200px;"
                @onchange="SupplierFilterChanged">

            <option value="">
                All Suppliers
            </option>

            @foreach (var supplier in suppliers)
            {
                <option value="@supplier.Id">
                    @supplier.Name
                </option>
            }

        </select>

    <!-- ADD BUTTON -->

    <button class="btn btn-primary shadow-sm"
            @onclick="ShowCreateModal">

        <i class="bi bi-plus-circle me-2"></i>

        Add Item

    </button>

    </div>

    </div>

<!-- ITEMS GRID -->

@if (items == null)
{
    <LoadingSpinner Text="Loading inventory items..." />
}
else if (!items.Any())
{
    <EmptyState
        Title="No Items Found"
        Message="No inventory items available." />
}
else
{
    <RadzenCard Variant="Variant.Flat"
                class="shadow-sm border-0">

        <RadzenDataGrid Data="@filteredItems"
                        TItem="ItemResponseDto"
                        AllowPaging="true"
                        PageSize="10"
                        AllowSorting="true"
                        AllowFiltering="false"
                        Responsive="true"
                        EmptyText="No items found">

            <Columns>

                <!-- SKU -->

                <RadzenDataGridColumn TItem="ItemResponseDto"
                                      Property="SKU"
                                      Title="SKU" />

                <!-- NAME -->

                <RadzenDataGridColumn TItem="ItemResponseDto"
                                      Property="Name"
                                      Title="Item" />

                <!-- PRICE -->

                <RadzenDataGridColumn TItem="ItemResponseDto"
                                      Property="SellingPrice"
                                      Title="Price">

                    <Template Context="item">

                        <span class="fw-semibold text-success">

                            @($"R {item.SellingPrice:N2}")

                        </span>

                    </Template>

                </RadzenDataGridColumn>

                <!-- STOCK -->

                <RadzenDataGridColumn TItem="ItemResponseDto"
                                      Property="OnHand"
                                      Title="Stock">

                    <Template Context="item">

                        @if (item.OnHand <= item.LowStockThreshold)
                        {
                            <RadzenBadge Text="@($"{item.OnHand} Low")"
                                         BadgeStyle="BadgeStyle.Warning"
                                         Shade="Shade.Light"
                                         Variant="Variant.Flat" />
                        }
                        else
                        {
                            <RadzenBadge Text="@($"{item.OnHand} Healthy")"
                                         BadgeStyle="BadgeStyle.Success"
                                         Shade="Shade.Light"
                                         Variant="Variant.Flat" />
                        }

                    </Template>

                </RadzenDataGridColumn>

                <!-- ACTIONS -->

                <RadzenDataGridColumn TItem="ItemResponseDto"
                                      Title="Actions"
                                      Width="180px"
                                      Sortable="false"
                                      Filterable="false">

                    <Template Context="item">

                        <div class="d-flex gap-2">

                            <!-- EDIT -->

                            <button class="btn btn-sm btn-outline-secondary"
                                    title="Edit Item"
                                    @onclick="() => ShowEditModal(item)">

                                <i class="bi bi-pencil"></i>

                            </button>

                            <!-- DELETE -->

                            <button class="btn btn-sm btn-outline-danger"
                                    title="Delete Item"
                                    @onclick="() => ShowDeleteModal(item)">

                                <i class="bi bi-trash"></i>

                            </button>

                        </div>

                    </Template>

                </RadzenDataGridColumn>

            </Columns>

        </RadzenDataGrid>

    </RadzenCard>
}

<!-- CREATE MODAL -->

@if (showCreateModal)
{
    <ItemFormModal Title="Create Item"
                   IsCreate="true"
                   OnSaved="ReloadItems"
                   OnClose="@(() => showCreateModal = false)" />
}

<!-- EDIT MODAL -->

@if (showEditModal && selectedItem != null)
{
    <ItemFormModal Title="Edit Item"
                   IsCreate="false"
                   EditModel="selectedItem"
                   OnSaved="ReloadItems"
                   OnClose="@(() => showEditModal = false)" />
}

<!-- DELETE MODAL -->

@if (showDeleteModal && selectedItem != null)
{
    <div class="modal fade show d-block"
         style="background: rgba(0,0,0,0.5)">

        <div class="modal-dialog">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        Delete Item
                    </h5>

                </div>

                <div class="modal-body">

                    <p>

                        Are you sure you want to delete

                        <strong>@selectedItem.Name</strong>?

                    </p>

                </div>

                <div class="modal-footer">

                    <button class="btn btn-danger"
                            @onclick="DeleteItem">

                        Delete

                    </button>

                    <button class="btn btn-secondary"
                            @onclick="HideDeleteModal">

                        Cancel

                    </button>

                </div>

            </div>

        </div>

    </div>
}

@code {

    private List<ItemResponseDto>? items;

    private List<ItemResponseDto> filteredItems = new();

    private ItemResponseDto? selectedItem;

    private bool showCreateModal = false;

    private bool showEditModal = false;

    private bool showDeleteModal = false;

    private string searchText = "";

    private List<SupplierDto> suppliers = new();

    private int? selectedSupplierId;

    protected override async Task OnInitializedAsync()
    {
        suppliers = await SupplierService.GetAllAsync();

        await ReloadItems();
    }

    private async Task ReloadItems()
    {
        items =
            await ItemService
                .GetAllAsync();

        ApplyFilters();
    }

    private void SearchChanged(ChangeEventArgs e)
    {
        searchText =
            e.Value?.ToString() ?? "";

        ApplyFilters();
    }

    private void ApplyFilters()
    {
        if (items == null)
            return;

        IEnumerable<ItemResponseDto> query = items;

        if (!string.IsNullOrWhiteSpace(searchText))
        {
            var s =
                searchText.ToLower();

            query =
                query.Where(i =>
                       i.Name.ToLower().Contains(s)
                    || i.SKU.ToLower().Contains(s));
        }

        if (selectedSupplierId.HasValue)
        {
            query = query.Where(i => i.SupplierId.HasValue && i.SupplierId.Value == selectedSupplierId.Value);
        }

        filteredItems =
            query.ToList();
    }

    private void SupplierFilterChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();

        if (int.TryParse(val, out var id))
            selectedSupplierId = id;
        else
            selectedSupplierId = null;

        ApplyFilters();
    }

    private void ShowCreateModal()
    {
        selectedItem = null;

        showCreateModal = true;
    }

    private void ShowEditModal(
        ItemResponseDto item)
    {
        selectedItem = item;

        showEditModal = true;
    }

    private void ShowDeleteModal(
        ItemResponseDto item)
    {
        selectedItem = item;

        showDeleteModal = true;
    }

    private void HideDeleteModal()
    {
        showDeleteModal = false;
    }

    private async Task DeleteItem()
    {
        if (selectedItem == null)
            return;

        var success =
            await ItemService
                .DeleteAsync(selectedItem.Id);

        if (success)
            await ReloadItems();

        showDeleteModal = false;
    }
}