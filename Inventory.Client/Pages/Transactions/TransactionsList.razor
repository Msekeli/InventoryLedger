@page "/transactions"

@using Inventory.Client.Models.Transactions
@using Inventory.Client.Components.Transactions

@inject IStockTransactionService TransactionService

<TransactionHeader
    Subtitle="Track inventory movement activity"
    OnButtonClick="(()=> showAddModal = true)" />

<TransactionFilters
    Search="@search"
    TransactionType="@filterType"
    DateFilter="@filterDate"
    SearchChanged="OnSearchUpdated"
    TransactionTypeChanged="OnTransactionTypeUpdated"
    DateFilterChanged="OnDateFilterUpdated"
    OnClear="ClearFilters" />

@if (isLoading)
{
    <LoadingSpinner />
}
else
{
    <div class="row g-3">

        <!-- ACTIVITY FEED -->
        <div class="col-xl-4">

            <RadzenCard>

                <div class="d-flex justify-content-between align-items-center mb-3">

                    <div>
                        <h5 class="mb-0">
                            Recent Activity
                        </h5>

                        <small class="text-muted">
                            Latest stock movement
                        </small>
                    </div>

                    <RadzenBadge
                        Text="@filteredTransactions.Count.ToString()"
                        Shade="Shade.Light" />

                </div>

                @if (!filteredTransactions.Any())
                {
                    <EmptyState
                        Title="No transactions found"
                        Message="Inventory movement activity will appear here." />
                }
                else
                {
                    <div class="d-flex flex-column gap-2">

                        @foreach (var tx in filteredTransactions.Take(5))
                        {
                            <StockMovementCard
                                Transaction="tx" />
                        }

                    </div>
                }

            </RadzenCard>

        </div>

        <!-- GRID -->
        <div class="col-xl-8">

            <RadzenCard>

                <div class="d-flex justify-content-between align-items-center mb-3">

                    <div>
                        <h5 class="mb-0">
                            Movement History
                        </h5>

                        <small class="text-muted">
                            Inventory transaction records
                        </small>
                    </div>

                </div>

                <TransactionGrid
                    Transactions="filteredTransactions" />

            </RadzenCard>

        </div>

    </div>
}

@if (showAddModal)
{
    <TransactionFormModal
        OnSaved="ReloadTransactions"
        OnClose="@(()=> showAddModal = false)" />
}

@code {

    private List<StockTransactionDto> allTransactions = new();
    private List<StockTransactionDto> filteredTransactions = new();

    private bool isLoading = true;
    private bool showAddModal = false;

    // FILTERS

    private string search = "";
    private string filterType = "";
    private string filterDate = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadTransactions();
    }

    private async Task LoadTransactions()
    {
        try
        {
            isLoading = true;

            allTransactions =
                await TransactionService.GetAllAsync();

            ApplyFilters();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplyFilters()
    {
        IEnumerable<StockTransactionDto> query =
            allTransactions;

        // SEARCH

        if (!string.IsNullOrWhiteSpace(search))
        {
            query = query.Where(x =>

                (!string.IsNullOrWhiteSpace(x.ReferenceNumber)
                    && x.ReferenceNumber.Contains(search,
                        StringComparison.OrdinalIgnoreCase))

                ||

                (!string.IsNullOrWhiteSpace(x.ItemName)
                    && x.ItemName.Contains(search,
                        StringComparison.OrdinalIgnoreCase))

                ||

                (!string.IsNullOrWhiteSpace(x.Notes)
                    && x.Notes.Contains(search,
                        StringComparison.OrdinalIgnoreCase))
            );
        }

        // TYPE

        if (!string.IsNullOrWhiteSpace(filterType))
        {
            int transactionType =
                int.Parse(filterType);

            query = query.Where(x =>
                x.TransactionType == transactionType);
        }

        // DATE

        if (!string.IsNullOrWhiteSpace(filterDate))
        {
            if (filterDate == "today")
            {
                var today = DateTime.Now.Date;

                query = query.Where(x =>
                    x.Timestamp.ToLocalTime().Date == today);
            }
            else
            {
                int days = int.Parse(filterDate);

                var minDate =
                    DateTime.Now.AddDays(-days);

                query = query.Where(x =>
                    x.Timestamp.ToLocalTime() >= minDate);
            }
        }

        filteredTransactions = query
            .OrderByDescending(x => x.Timestamp)
            .ToList();
    }

    // FILTER EVENTS

    private Task OnSearchUpdated(string value)
    {
        search = value;

        ApplyFilters();

        return Task.CompletedTask;
    }

    private Task OnTransactionTypeUpdated(string value)
    {
        filterType = value;

        ApplyFilters();

        return Task.CompletedTask;
    }

    private Task OnDateFilterUpdated(string value)
    {
        filterDate = value;

        ApplyFilters();

        return Task.CompletedTask;
    }

    private Task ClearFilters()
    {
        search = "";
        filterType = "";
        filterDate = "";

        ApplyFilters();

        return Task.CompletedTask;
    }

    // MODAL REFRESH

    private async Task ReloadTransactions()
    {
        showAddModal = false;

        await LoadTransactions();
    }
}