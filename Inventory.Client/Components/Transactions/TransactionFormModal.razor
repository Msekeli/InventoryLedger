@using Inventory.Client.Models.Transactions
@using Inventory.Client.Services.Transactions

@inject IStockTransactionService TransactionService

<div class="modal fade show d-block" style="background: rgba(0,0,0,0.5)">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">New Transaction</h5>
            </div>

            <div class="modal-body">

                <div class="mb-3">
                    <label class="form-label">Type</label>
                    <select class="form-select" @bind="Model.TransactionType">
                        <option value="1">IN</option>
                        <option value="2">OUT</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Quantity</label>
                    <input type="number" class="form-control" @bind="Model.Quantity" min="1" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Reference</label>
                    <input class="form-control" @bind="Model.ReferenceNumber" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Notes</label>
                    <textarea class="form-control" rows="3" @bind="Model.Notes"></textarea>
                </div>

            </div>

            <div class="modal-footer">
                <button class="btn btn-primary" @onclick="Save">Save</button>
                <button class="btn btn-secondary" @onclick="Close">Cancel</button>
            </div>

        </div>
    </div>
</div>

@code {
    [Parameter]
    public int ItemId { get; set; }

    [Parameter]
    public EventCallback OnSaved { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private CreateStockTransactionDto Model = new();

    protected override void OnParametersSet()
    {
        Model.ItemId = ItemId;
        Model.Quantity = 1;
        Model.TransactionType = 1;
    }

    private async Task Save()
    {
        if (Model.Quantity <= 0)
            return;

        var success = await TransactionService.CreateAsync(Model);

        if (success)
        {
            await OnSaved.InvokeAsync();
            await OnClose.InvokeAsync();
        }
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }
}
