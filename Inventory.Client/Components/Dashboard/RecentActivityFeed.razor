@using Inventory.Client.Models.Transactions
@using Inventory.Client.Services.Dashboard

@inject DashboardService DashboardService

@if (_isLoading)
{
    <LoadingSpinner Text="Loading recent activity..." />
}
else if (!_transactions.Any())
{
    <EmptyState
        Title="No Activity Found"
        Message="No recent inventory activity available." />
}
else
{
    <RadzenCard Variant="Variant.Flat"
                class="shadow-sm border-0 h-100">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>

                <h5 class="fw-bold mb-1">
                    Recent Activity
                </h5>

                <small class="text-muted">
                    Latest inventory movement
                </small>

            </div>

            <RadzenIcon Icon="timeline"
                        class="fs-2 text-primary" />

        </div>

        <div class="d-flex flex-column gap-3">

            @foreach (var tx in _transactions.Take(8))
            {
                <div class="d-flex justify-content-between align-items-center p-3 rounded bg-light">

                    <div class="d-flex align-items-center gap-3">

                        @if (tx.IsIncrease)
                        {
                            <div class="bg-success bg-opacity-10 rounded-circle p-2">

                                <RadzenIcon Icon="north"
                                            class="text-success" />

                            </div>
                        }
                        else
                        {
                            <div class="bg-danger bg-opacity-10 rounded-circle p-2">

                                <RadzenIcon Icon="south"
                                            class="text-danger" />

                            </div>
                        }

                        <div>

                            <div class="fw-semibold">

                                @(tx.IsIncrease
                                    ? $"Received {tx.Quantity} {tx.ItemName}"
                                    : $"Sold {tx.Quantity} {tx.ItemName}")

                            </div>

                            <small class="text-muted">
                                @tx.ReferenceNumber
                            </small>

                        </div>

                    </div>

                    <div class="text-end">

                        <div class="fw-semibold">

                            @(tx.Timestamp
                                .ToLocalTime()
                                .ToString("g"))

                        </div>

                        @if (tx.IsIncrease)
                        {
                            <small class="text-success fw-semibold">
                                STOCK IN
                            </small>
                        }
                        else
                        {
                            <small class="text-danger fw-semibold">
                                STOCK OUT
                            </small>
                        }

                    </div>

                </div>
            }

        </div>

    </RadzenCard>
}

@code {

    private bool _isLoading = true;

    private List<StockTransactionDto> _transactions = new();

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;

        _transactions =
            await DashboardService
                .GetRecentTransactionsAsync();

        _isLoading = false;
    }
}