@inherits LayoutComponentBase

<div class="app-shell">

    <!-- SIDEBAR -->
    <aside class="app-sidebar">
        <RadzenPanelMenu Style="border:none;">
            <RadzenPanelMenuItem Text="Dashboard" Icon="dashboard" Path="/" />
            <RadzenPanelMenuItem Text="Items" Icon="inventory_2" Path="/items" />
            <RadzenPanelMenuItem Text="Transactions" Icon="receipt_long" Path="/transactions" />
            <RadzenPanelMenuItem Text="Low Stock" Icon="warning" Path="/low-stock" />
            <RadzenPanelMenuItem Text="Suppliers" Icon="local_shipping" Path="/suppliers" />
            <RadzenPanelMenuItem Text="Logout" Icon="logout" Path="/login" />
        </RadzenPanelMenu>
    </aside>

    <!-- TOP HEADER -->
    <header class="app-header">

        <!-- LEFT BRAND -->
        <div class="header-brand">
            <div>
                <h4>Spaza Stock Manager</h4>
                <small>Inventory ERP</small>
            </div>
        </div>

        <!-- RIGHT USER -->
        <div class="top-header-user">
            <RadzenBadge Text="Owner"
                         Shade="Shade.Light"
                         Variant="Variant.Flat" />

            <span class="fw-semibold">Demo User</span>

            <RadzenButton Text="Logout"
                          Icon="logout"
                          ButtonStyle="ButtonStyle.Light" />
        </div>

    </header>

    <!-- MAIN CONTENT -->
    <main class="app-content">
        @Body
    </main>

</div>